# ================================================================
# MORRA.ASIA — ENVIRONMENT CONFIGURATION TEMPLATE
# Salin fail ini ke .env.local dan masukkan nilai sebenar anda.
# JANGAN SEKALI-KALI MASUKKAN KREDENSIAL SEBENAR KE DALAM GIT!
# ================================================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# CHIP Payment Gateway Configuration
CHIP_BRAND_ID=your-chip-brand-id-here
CHIP_SECRET_KEY=your-chip-secret-key-here
CHIP_WEBHOOK_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
